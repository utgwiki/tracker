# Discord Bot Token from the Discord Developer Portal
TOKEN=YOUR_DISCORD_TOKEN_HERE

# Visit announcement frequency (e.g., 10000 for every 10k visits)
FREQUENCY=10000

# Roblox Universe ID (NOT the Game ID/Place ID)
# To find your Universe ID, visit: https://apis.roblox.com/universes/v1/places/{YOUR_PLACE_ID}/universe
UNIVERSEID=YOUR_UNIVERSEID_HERE

# Discord Channel ID where announcements will be sent
CHANNELID=YOUR_CHANNELID_HERE

# To track multiple games, append _2, _3, etc. to UNIVERSEID and CHANNELID
# UNIVERSEID_2=YOUR_SECOND_UNIVERSEID
# CHANNELID_2=YOUR_SECOND_CHANNELID
